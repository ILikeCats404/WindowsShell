@* === IMPROVED COMET SYSTEM (CONSTANT STREAM + RANDOM SPAWN DELAY 1–5s) === *@

@if (Config.comets)
{
    <canvas id="cometCanvas"></canvas>
}

<script>
    (() => {
        let canvas, ctx;
        let w = 0, h = 0;
        let comets = [];
        let running = false;

        const COMET_COUNT = 2;

        function resize() {
            if (!canvas) return;
            w = canvas.width = window.innerWidth;
            h = canvas.height = window.innerHeight;
        }

        function spawn() {
            return {
                x: Math.random() * w * 0.2 - 100,
                y: Math.random() * h * 0.6,
                vx: 4 + Math.random() * 7,
                vy: 2 + Math.random() * 5,
                len: 90 + Math.random() * 140,
                respawning: false
            };
        }

        function scheduleRespawn(c) {
            if (c.respawning) return;
            c.respawning = true;

            const delay = 1000 + Math.random() * 4000; // 1–5 seconds

            setTimeout(() => {
                c.x = -150;
                c.y = Math.random() * h;
                c.vx = 4 + Math.random() * 7;
                c.vy = 2 + Math.random() * 5;
                c.len = 90 + Math.random() * 140;
                c.respawning = false;
            }, delay);
        }

        function draw() {
            if (!running || !canvas) return;

            ctx.clearRect(0, 0, w, h);

            for (let c of comets) {

                if (c.respawning) continue;

                c.x += c.vx;
                c.y += c.vy;

                const mag = Math.sqrt(c.vx * c.vx + c.vy * c.vy);
                const dx = (c.vx / mag) * c.len;
                const dy = (c.vy / mag) * c.len;

                const x2 = c.x - dx;
                const y2 = c.y - dy;

                const alpha = 0.9;

                const grad = ctx.createLinearGradient(c.x, c.y, x2, y2);
                grad.addColorStop(0, `rgba(255,255,255,${alpha})`);
                grad.addColorStop(0.4, `rgba(255,255,255,0.5)`);
                grad.addColorStop(1, `rgba(255,255,255,0)`);

                ctx.strokeStyle = grad;
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.moveTo(c.x, c.y);
                ctx.lineTo(x2, y2);
                ctx.stroke();

                ctx.beginPath();
                ctx.fillStyle = `rgba(255,255,255,${alpha})`;
                ctx.arc(c.x, c.y, 2.5, 0, Math.PI * 2);
                ctx.fill();

                if (c.x > w + 200 || c.y > h + 200) {
                    scheduleRespawn(c);
                }
            }

            requestAnimationFrame(draw);
        }

        function init() {
            canvas = document.getElementById('cometCanvas');
            if (!canvas) {
                requestAnimationFrame(init);
                return;
            }

            ctx = canvas.getContext('2d');
            resize();

            comets = Array.from({ length: COMET_COUNT }, () => spawn());

            window.addEventListener('resize', resize);

            running = true;
            draw();
        }

        init();
    })();
</script>

<style>
    #cometCanvas {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 3;
    }
</style>


<div class="dashboard">
    <button class="settings-gear" title="Settings" @onclick="OpenSettings">
        ⚙
    </button>

    <!-- Click-through status widget -->
    <div class="widget clickthrough-widget">
        @if (!DevStuff.IsClickThrough)
        {
            <div class="status clickable">Clickable</div>
        }
        else
        {
            <div class="status background">Background</div>
        }
    </div>
    <div class="overlay"></div>

    <div class="open-apps-bar">
        <div class="bottom-bar-shortcuts">
            @foreach (var item in shortcuts)
            {
                <button class="taskbar-item" @onclick="() => Open(item)" title="@item.Name">
                    @if (!string.IsNullOrEmpty(item.IconBase64))
                    {
                        <img src="data:image/png;base64,@item.IconBase64"
                             class="taskbar-icon" />
                    }
                    else
                    {
                        <div class="taskbar-fallback"></div>
                    }
                </button>
            }
        </div>

        <button class="bottom-bar-clock"
                title="Toggle clickable"
                @onclick="ToggleClickable">
            <span>@CurrentTime.ToString("hh:mm:ss tt")</span>
            <span>@CurrentTime.ToString("HH:mm")</span>
            <span>@CurrentTime.ToString("MMMM/MM/dd/yy")</span>
        </button>

        <div class="bottom-bar-windows">
            @foreach (var window in openWindows)
            {
                <button class="open-app-button @(window.IsMinimized ? "minimized" : "")"
                        title="@window.Title"
                        @onclick="() => ActivateWindow(window)">
                    <span class="open-app-dot"></span>
                    <span class="open-app-name">@GetWindowLabel(window)</span>
                </button>
            }
        </div>
    </div>
    <div class="discord-messages-panel">

        <div class="discord-messages-header">
            Discord Feed @foreach (var chan in DiscordB.Channels)
            {

                // Executed during render loop (Not recommended for API calls due to lag)
                var task = DiscordB.GetNameAsync(chan);
                var id = chan;
                <button class="discord-chan" @onclick="() => ChangeChan(id)">@(task.IsCompleted ? task.Result : "Loading...")</button>

            }
        </div>

        <div @ref="DiscordBox" class="discord-messages-list">

            @foreach (var msg in DiscordMessages)
            {
                <div class="discord-message">
                    @((MarkupString)msg)
                </div>
            }

        </div>

        <div class="discord-message-input">

            <input class="discord-input"
                   @bind="DiscordInput"
                   @bind:event="oninput"
                   placeholder="message..." />

            <button class="discord-send"
                    @onclick="SendDiscordMessage">
                send
            </button>

        </div>

    </div>
    <div class="dock">

        <!-- Time -->
        <div class="widget time-widget">
            <div class="time">
                @CurrentTime.ToString("hh:mm tt")
            </div>

            <div class="date">
                @CurrentTime.ToString("MMM dd")
            </div>
        </div>

        <!-- Weather -->
        <div class="widget weather-widget">
            @if (!PrivacyMode)
            {
                @if (LoadingWeather)
                {
                    <div class="weather-loading">
                        ...
                    </div>
                }
                else
                {
                    <div class="weather-temp">
                        <button class="Toggle-Privacy" @onclick="togglePrivacy">@Temperature°</button>
                    </div>

                    <div class="weather-desc">
                        @WeatherDescription
                    </div>
                }
            }
            else
            {
                <button class="Toggle-Privacy" @onclick="togglePrivacy">Privacy mode enabled!</button>
            }
            </div>

        <!-- App Buttons -->
        <div class="apps-grid">

            <button class="app-button discord"
                    title="Discord"
                    @onclick="OpenDiscord">
                <img src="discord.png"
                     class="icon-image filter" />
            </button>

            <button class="app-button explorer"
                    title="Explorer"
                    @onclick="OpenExplorer">
                <div class="emoji-icon">📁</div>
            </button>

            <button class="app-button firefox"
                    title="Firefox"
                    @onclick="OpenFirefox">
                <img src="/firefox.png"
                     class="icon-image no-filter" />
            </button>

            <button class="termius app-button" title="Termius" @onclick="OpenTermius">
                <img src="termius.png" class="termius-icon" />
            </button>
        </div>
    </div>
    <div class="queue-terminal">

        <div class="terminal-topbar">
            <button class="terminal-button start"
                    @onclick="StartQueue">
                start
            </button>

            <button class="terminal-button stop"
                    @onclick="StopQueue">
                stop
            </button>
        </div>

        <div @ref="CmdBox" class="terminal-output">
            @foreach (var item in QueueItems.AsEnumerable())
            {
                <p class="terminal-line">
                    @item
                </p>
            }
        </div>

        <div class="terminal-input-area">

            <input class="terminal-input"
                   @bind="InputText"
                   @bind:event="oninput"
                   placeholder="type here..." />

            <button class="terminal-send"
                    @onclick="SubmitInput">
                >
            </button>

        </div>

    </div>

</div>
<script>
        window.scrollElementToBottom = function (element) {
        if (!element)
            return;

        element.scrollTop = element.scrollHeight;
    };
</script>
@code {
    //weather to toggle the weather or not
    private bool PrivacyMode = false;
    //widges
    private DateTime CurrentTime = DateTime.Now;
    //weather
    private bool LoadingWeather = true;

    private int Temperature = 0;

    private int chan = 0;
    private string WeatherDescription = "Unknown";
    //??
    private System.Threading.Timer? _timer;
    //shortcut stuff
    private List<TaskbarShortcut> shortcuts = new();
    private List<OpenWindowInfo> openWindows = new();

    //inbuilt cmd
    Process process = null;
    private string cmdStatus = "Off";
    private StreamReader CmdOut;
    private StreamReader Cmderr;
    private StreamWriter Cmdin;
    private readonly ConcurrentQueue<string> QueueItems = new();
    private string InputText = "";
    //discord
    private List<string> DiscordMessages = new();

    private string DiscordInput = "";
    //element refereces
    private ElementReference DiscordBox;
    private ElementReference CmdBox;
    private void togglePrivacy()
    {
        PrivacyMode = !PrivacyMode;
    }
    private async Task ChangeChan(ulong id)
    {
        DiscordInput = "chan=" + id.ToString();
        await SendDiscordMessage();
    }
    private async Task SendDiscordMessage()
    {
        if (DiscordInput.ToLower().StartsWith("chan="))
        {
            ulong chanid = 0;
            if (ulong.TryParse(DiscordInput.Substring(5), out chanid))
            {
                DiscordB.selectedId = chanid;
                DiscordInput = "";
                await SendDiscordMessage();
            }
            else
            {
                
                var alert = await DiscordB.GetAlert("Invalid Channel ID!");
                DiscordMessages.Add(alert);
                StateHasChanged();
                await JS.InvokeVoidAsync("scrollElementToBottom", DiscordBox);
            }
        }
        else
        {
            await DiscordB.SendMessage(DiscordInput);
            DiscordInput = "";
            
            DiscordMessages = await DiscordB.GetMessages();
            DiscordMessages.Reverse();
            StateHasChanged();
            await JS.InvokeVoidAsync("scrollElementToBottom", DiscordBox);
        }
    }
    private void SubmitInput()
    {
        try
        {
            if (!process.HasExited && process != null)
            {
                Cmdin.WriteLineAsync(InputText);
                StateHasChanged();
            }
            else
            {
                cmdStatus = "START IT!";
            }
        }
        catch (Exception ex)
        {
            cmdStatus = ex.Message;
        }
    }



    private void StartQueue()
    {
        try
        {
            if (process == null)
            {

                process = new Process();
                process.StartInfo.FileName = "C:\\WINDOWS\\system32\\cmd.exe";
                process.StartInfo.RedirectStandardError = true;
                process.StartInfo.RedirectStandardInput = true;
                process.StartInfo.RedirectStandardOutput = true;
                process.StartInfo.UseShellExecute = false;
                process.StartInfo.CreateNoWindow = true;
                process.Start();
                CmdOut = process.StandardOutput;
                Cmderr = process.StandardError;
                Cmdin = process.StandardInput;

                _ = Task.Run(async () =>
{
    try
    {
        while (CmdOut != null)
        {
            string? line = await CmdOut.ReadLineAsync();

            if (line == null)
                break;

            if (!string.IsNullOrWhiteSpace(line)) {
                if (line.Contains(Config.privateUsername)){
                    line = line.Replace(Config.privateUsername, "*****");
                }
                QueueItems.Enqueue("[S] " + line);
                await JS.InvokeVoidAsync("scrollElementToBottom", DiscordBox);
            }
        }
    }
    catch (Exception ex)
    {
        Debug.WriteLine(ex);
    }
});

                _ = Task.Run(async () =>
                {
                    try
                    {
                        while (Cmderr != null)
                        {
                            string? line = await Cmderr.ReadLineAsync();

                            if (line == null)
                                break;

                            if (!string.IsNullOrWhiteSpace(line)) {
                                QueueItems.Enqueue("[ERR] " + line);
                                await JS.InvokeVoidAsync("scrollElementToBottom", DiscordBox);
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        Debug.WriteLine(ex);
                    }
                });


            }
            else
            {
                cmdStatus = "ruh ro somethings busted.";
            }
        }
        catch (Exception ex)
        {
            cmdStatus = "Something went wrong! " + ex.Message + ex.StackTrace;
        }
    }

    private void StopQueue()
    {
        process.Kill();
        process = null;
        cmdStatus = "Off";
    }
    protected override async Task OnInitializedAsync()
    {
        DiscordB.selectedId = 0;
        _timer = new System.Threading.Timer(_ =>
        {
            CurrentTime = TimeZoneInfo.ConvertTimeBySystemTimeZoneId(
                DateTime.Now,
                "Mountain Standard Time");
            openWindows = OpenWindowsService.GetOpenWindows();

            InvokeAsync(StateHasChanged);
        }, null, 0, 1000);
        Debug.WriteLine("!!Starting discord bot!!");
        DiscordB.start();
        shortcuts = ShortcutsService.GetShortcuts();
        openWindows = OpenWindowsService.GetOpenWindows();
        await LoadWeather();
    }

    private async Task LoadWeather()
    {
        try
        {
            using HttpClient http = new();

            string url =
                "https://api.open-meteo.com/v1/forecast" +
                $"?latitude={Config.lat}" +
                $"&longitude={Config.longi}" +
                "&current=temperature_2m,weather_code" +
                "&temperature_unit=fahrenheit";

            var response = await http.GetFromJsonAsync<WeatherResponse>(url);

            if (response?.current != null)
            {
                Temperature = (int)Math.Round(response.current.temperature_2m);
                WeatherDescription = GetWeatherDescription(response.current.weather_code);
            }
        }
        catch
        {
            WeatherDescription = "Offline";
        }

        LoadingWeather = false;
    }

    private static string GetWeatherDescription(int code)
    {
        return code switch
        {
            0 => "Clear",
            1 => "Mostly Clear",
            2 => "Cloudy",
            3 => "Overcast",
            61 => "Rain",
            71 => "Snow",
            95 => "Storm",
            _ => "Weather"
        };
    }

    private void OpenDiscord()
    {
        Navigation.NavigateTo("/lake");
        //TryStart(Config.discordPath);
    }

    private void OpenSettings()
    {
        Navigation.NavigateTo("/settings");
    }

    private void OpenExplorer()
    {
        TryStart("explorer.exe");
    }

    private void OpenFirefox()
    {
        TryStart("firefox.exe");
    }

    private void OpenTermius()
    {
        TryStart(Config.termiusPath);
    }

    private void TryStart(string process)
    {
        try
        {
            Process.Start(new ProcessStartInfo
            {
                FileName = process,
                UseShellExecute = true
            });
        }
        catch
        {
        }
        finally
        {
            MauiProgram.DisableInteractiveMode();
        }
    }

    async Task Open(TaskbarShortcut item)
    {
        await ShortcutsService.LaunchAsync(item);
    }

    private void ActivateWindow(OpenWindowInfo window)
    {
        OpenWindowsService.ToggleWindow(window);
        openWindows = OpenWindowsService.GetOpenWindows();
        MauiProgram.DisableInteractiveMode();
    }

    private void ToggleClickable()
    {
        MauiProgram.ToggleClickableMode();
    }

    private static string GetWindowLabel(OpenWindowInfo window)
    {
        return string.IsNullOrWhiteSpace(window.ProcessName)
            ? window.Title
            : window.ProcessName;
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    public class WeatherResponse
    {
        public CurrentWeather? current { get; set; }
    }

    public class CurrentWeather
    {
        public double temperature_2m { get; set; }

        public int weather_code { get; set; }
    }
}

