@page "/settings"
@inject NavigationManager Navigation

<main class="settings-page">
    <section class="settings-shell">
        <header class="settings-header">
            <button class="back-button" title="Back" @onclick="Back">‹</button>
            <div>
                <h1>Settings</h1>
                <p>@Config.SettingsFilePath</p>
            </div>
        </header>

        <div class="settings-grid">
            <label class="setting-row toggle-row">
                <span>Comets</span>
                <input type="checkbox" @bind="comets" />
            </label>

            <label class="setting-row">
                <span>Discord channels</span>
                <textarea @bind="channels" rows="3"></textarea>
            </label>

            <label class="setting-row">
                <span>Latitude</span>
                <input @bind="lat" />
            </label>

            <label class="setting-row">
                <span>Longitude</span>
                <input @bind="longi" />
            </label>

            <label class="setting-row">
                <span>Private username</span>
                <input @bind="privateUsername" />
            </label>

            <label class="setting-row">
                <span>Discord path</span>
                <input @bind="discordPath" />
            </label>

            <label class="setting-row">
                <span>Termius path</span>
                <input @bind="termiusPath" />
            </label>
        </div>

        <footer class="settings-actions">
            <span>@status</span>
            <button class="save-button" @onclick="Save">Save</button>
        </footer>
    </section>
</main>

@code {
    private bool comets;
    private string channels = "";
    private string longi = "";
    private string lat = "";
    private string privateUsername = "";
    private string discordPath = "";
    private string termiusPath = "";
    private string status = "Loaded from config";

    protected override void OnInitialized()
    {
        comets = Config.comets;
        channels = Config.channels;
        longi = Config.longi;
        lat = Config.lat;
        privateUsername = Config.privateUsername;
        discordPath = Config.discordPath;
        termiusPath = Config.termiusPath;
    }

    private void Save()
    {
        Config.comets = comets;
        Config.channels = channels;
        Config.longi = longi;
        Config.lat = lat;
        Config.privateUsername = privateUsername;
        Config.discordPath = discordPath;
        Config.termiusPath = termiusPath;
        Config.Save();
        status = $"Saved {DateTime.Now:h:mm:ss tt}";
    }

    private void Back()
    {
        Navigation.NavigateTo("/");
    }
}

<style>
    html, body {
        margin: 0;
        min-height: 100%;
        background: #4a4a4a;
        font-family: "Segoe UI", sans-serif;
    }

    .settings-page {
        min-height: 100vh;
        background: #4a4a4a;
        color: #f4f4f4;
        padding: 48px;
        box-sizing: border-box;
    }

    .settings-shell {
        width: min(860px, 100%);
        margin: 0 auto;
    }

    .settings-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 26px;
    }

    .settings-header h1 {
        margin: 0;
        font-size: 32px;
        font-weight: 700;
    }

    .settings-header p {
        margin: 6px 0 0;
        color: rgba(255,255,255,0.62);
        font-family: Consolas, monospace;
        font-size: 12px;
        word-break: break-all;
    }

    .back-button {
        width: 42px;
        height: 42px;
        border: 1px solid rgba(255,255,255,0.18);
        border-radius: 8px;
        background: rgba(255,255,255,0.08);
        color: white;
        font-size: 30px;
        line-height: 1;
        cursor: pointer;
    }

    .settings-grid {
        display: grid;
        gap: 14px;
    }

    .setting-row {
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 18px;
        align-items: center;
        padding: 16px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 8px;
    }

    .setting-row span {
        font-size: 14px;
        font-weight: 600;
        color: rgba(255,255,255,0.82);
    }

    .setting-row input,
    .setting-row textarea {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid rgba(255,255,255,0.16);
        border-radius: 6px;
        background: rgba(20,20,20,0.72);
        color: white;
        padding: 10px 12px;
        font: 13px Consolas, monospace;
        outline: none;
    }

    .setting-row input[type="checkbox"] {
        width: 22px;
        height: 22px;
        accent-color: #a8d46f;
    }

    .toggle-row {
        grid-template-columns: 180px 1fr;
    }

    .settings-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 20px;
        color: rgba(255,255,255,0.7);
        font-size: 13px;
    }

    .save-button {
        height: 40px;
        min-width: 110px;
        border: none;
        border-radius: 8px;
        background: #a8d46f;
        color: #151515;
        font-weight: 700;
        cursor: pointer;
    }

    @@media (max-width: 700px) {
        .settings-page {
            padding: 24px;
        }

        .setting-row {
            grid-template-columns: 1fr;
            gap: 10px;
        }
    }
</style>
